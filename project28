contacts = []

while True:

    print("\n1. Add contacts")
    print("2. Search contacts")
    print("3. View contacts")
    print("4. Delete contacts")
    print("5. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        name = input("Enter name: ")
        number = input("Enter number: ")

        contact = {"name": name, "number": number}

        contacts.append(contact)

        print("Contact saved!!!")

    elif choice == "2":
        search_name = input("Enter the name to be searched: ")

        found = False

        for c in contacts:
            if c["name"].lower() == search_name.lower():
                print(c["name"], "_", c["number"])
                found = True

        if not found:
            print("Contact does not exist")

    elif choice == "3":
        if len(contacts) == 0:
            print("NO CONTACTS YET!!!!!")
        else:
            for i in range(len(contacts)):
                print(i + 1, contacts[i]["name"], "_", contacts[i]["number"])

    elif choice == "4":
        if len(contacts) == 0:
            print("NO CONTACTS YET!!!!!")
        else:
            num = int(input("Enter contact number (position) to be deleted: "))

            if num > 0 and num <= len(contacts):
                removed = contacts.pop(num - 1)
                print("DELETED:", removed["name"])
            else:
                print("Invalid selection!!!")

    elif choice == "5":
        print("Goodbye!!!!!!")
        break

    else:
        print("Invalid choice!!!")
     
    
         


         
