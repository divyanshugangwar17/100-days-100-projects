account = {
    "name": "divyanshu gangwar",
    "balance": 560098,
    "pin": 9219,
    "account type": "businessaccount"
}

print("=== MINI ATM ===")

pin = int(input("Enter your PIN: "))

if pin == account["pin"]:
    while True:
        print("\n** ATM MENU **")
        print("1. Check balance")
        print("2. Withdraw money")
        print("3. Deposit money")
        print("4. Account details")
        print("5. Exit")

        choice = input("Enter your choice: ")

        if choice == "1":
            print("Your bank balance is:", account["balance"])

        elif choice == "2":
            amount = int(input("Enter withdrawal amount: "))

            if amount > 0 and amount <= account["balance"]:
                account["balance"] -= amount
                print("Money withdrawn successfully")
                print("Collect your cash")
                print("New balance:", account["balance"])
            else:
                print("Invalid amount or insufficient balance")

        elif choice == "3":
            amount = int(input("Enter deposit amount: "))

            if amount > 0:
                account["balance"] += amount
                print("Money deposited successfully")
                print("New balance:", account["balance"])
            else:
                print("Invalid amount")

        elif choice == "4":
            print("\nAccount name:", account["name"])
            print("Account type:", account["account type"])
            print("Account balance:", account["balance"])

        elif choice == "5":
            print("Thank you!!!")
            break

        else:
            print("Invalid choice")

else:
    print("Invalid PIN")
